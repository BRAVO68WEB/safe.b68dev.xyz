{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "corepack enable",
        "corepack prepare pnpm@9.15.4 --activate",
        "apt-get update && apt-get install -y python3 make g++ git ffmpeg",
        "pnpm install --frozen-lockfile"
      ]
    },
    "build": {
      "commands": [
        "pnpm build"
      ]
    }
  },
  "startCommand": "pnpm migrate && npx tsx ./lolisafe.ts",
  "environmentVariables": {
    "NODE_ENV": "production",
    "PORT": "9999"
  }
}
